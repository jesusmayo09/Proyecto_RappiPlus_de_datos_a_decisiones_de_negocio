          <formatted-text>
            <run bold='true' fontcolor='#4e79a7'>Crecimiento QoQ %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean' name='federated.04u81tx07ny74q1dny8f7192bx5w' />
          </datasources>
          <datasource-dependencies datasource='federated.04u81tx07ny74q1dny8f7192bx5w'>
            <column caption='Ventas Trimestre Actual' datatype='real' name='[Calculation_0653970845990921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;quarter&apos;, [fecha], {MAX([fecha])}) = 0 &#13;&#10;THEN [monto_total] &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Ventas Trimestre Anterior' datatype='real' name='[Calculation_0653970846248970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;quarter&apos;, [fecha], {MAX([fecha])}) = 1 &#13;&#10;THEN [monto_total] &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='QoQ %' datatype='real' default-format='p0.00%' name='[Calculation_0653970846343179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0653970845990921]) - SUM([Calculation_0653970846248970])) &#13;&#10;/ &#13;&#10;SUM([Calculation_0653970846248970])' />
            </column>
            <column caption='Canal' datatype='string' name='[canal]' role='dimension' type='nominal' />
