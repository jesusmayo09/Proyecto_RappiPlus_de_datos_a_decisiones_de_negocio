      <aliases enabled='yes' />
      <column caption='Costo Total' datatype='real' name='[Calculation_0653970515931136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cantidad] * [costo_unitario])' />
      </column>
      <column caption='Ingreso Total' datatype='real' name='[Calculation_0653970516963330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monto_total])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_0653970517233667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0653970516963330] - ([Calculation_0653970515931136] + [Calculation_0653970519203844])' />
      </column>
      <column caption='Costo Marketing' datatype='real' name='[Calculation_0653970519203844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gasto])' />
      </column>
      <column caption='Cantidad Promedio Producto' datatype='real' name='[Calculation_0653970521976837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cantidad]) / COUNTD([id_pedido])' />
      </column>
      <column caption='Margen Bruto' datatype='real' name='[Calculation_0653970839040006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0653970516963330] - [Calculation_0653970515931136]' />
      </column>
      <column caption='Unidades Vendidas' datatype='integer' name='[Calculation_0653970839588871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cantidad])' />
      </column>
      <column caption='Cantidad Ventas' datatype='integer' name='[Calculation_0653970843090952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id_pedido])' />
      </column>
      <column caption='Ventas Trimestre Actual' datatype='real' name='[Calculation_0653970845990921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;quarter&apos;, [fecha], {MAX([fecha])}) = 0 &#13;&#10;THEN [monto_total] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Ventas Trimestre Anterior' datatype='real' name='[Calculation_0653970846248970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;quarter&apos;, [fecha], {MAX([fecha])}) = 1 &#13;&#10;THEN [monto_total] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='QoQ %' datatype='real' default-format='p0.00%' name='[Calculation_0653970846343179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0653970845990921]) - SUM([Calculation_0653970846248970])) &#13;&#10;/ &#13;&#10;SUM([Calculation_0653970846248970])' />
      </column>
