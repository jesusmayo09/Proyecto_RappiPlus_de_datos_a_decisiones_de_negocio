            <column caption='Pais' datatype='string' name='[pais]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_0653970846343179]' derivation='User' name='[usr:Calculation_0653970846343179:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.04u81tx07ny74q1dny8f7192bx5w].[mn:fecha:ok]' filter-group='5'>
            <groupfilter function='level-members' level='[mn:fecha:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
